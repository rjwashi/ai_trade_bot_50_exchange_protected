# Binance.US first
EXCHANGE=binance_us

# SAFETY
STARTING_CAPITAL=50
RISK_PER_TRADE=0.01
MAX_POSITION_USD=15
DAILY_LOSS_LIMIT_USD=1.50
MIN_SCORE=80
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.04
POLL_SECONDS=60

# Leave false until you deliberately enable live mode.
ENABLE_LIVE_TRADING=false

# Binance.US API credentials
BINANCE_US_API_KEY=
BINANCE_US_API_SECRET=
